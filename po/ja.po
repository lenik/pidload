#: src/options.cpp:23
msgid ""
"Usage: pidload [OPTION]... [NAME]...\n"
"Monitor process load and selected device/network traffic in a wxWidgets window.\n"
msgstr ""
"使用法: pidload [オプション]... [名前]...\n"
"wxWidgets ウィンドウでプロセス負荷と選択したデバイス/ネットワークのトラフィックを監視します。\n"

#: src/options.cpp:27
msgid ""
"Each NAME matches processes, tried as:\n"
"  pid, executable name, executable path, window title,\n"
"  executable glob name, executable glob path, window glob title.\n"
"Glob characters: * ?   Example: pidload editor   pidload '*term*'\n"
msgstr ""
"各「名前」は次の順でプロセスと照合されます:\n"
"  PID、実行ファイル名、実行ファイルのパス、ウィンドウタイトル、\n"
"  実行ファイル名/パス/ウィンドウタイトルの glob パターン。\n"
"glob 文字: * ?   例: pidload editor   pidload '*term*'\n"

#: src/options.cpp:34
msgid "block device I/O to monitor (repeatable)\n"
msgstr "監視するブロックデバイス I/O（複数指定可）\n"

#: src/options.cpp:36
msgid "netdev to monitor, or \"all\" (repeatable)\n"
msgstr "監視するネットワークデバイス、または「all」（複数指定可）\n"

#: src/options.cpp:38
msgid "IPv4/IPv6 address traffic to monitor (repeatable)\n"
msgstr "監視する IPv4/IPv6 アドレスのトラフィック（複数指定可）\n"

#: src/options.cpp:40
msgid "chart system CPU (overall and each core)\n"
msgstr "システム CPU をグラフ表示（全体および各コア）\n"

#: src/options.cpp:42
msgid "chart system memory and swap\n"
msgstr "システムメモリとスワップをグラフ表示\n"

#: src/options.cpp:44
msgid "chart thread counts (alive / wait / total opened)\n"
msgstr "スレッド数をグラフ表示（稼働中 / 待機 / オープン総数）\n"

#: src/options.cpp:46
msgid "chart open file-descriptor counts\n"
msgstr "開いているファイル記述子数をグラフ表示\n"

#: src/options.cpp:48
msgid "chart net connections (alive / wait / total)\n"
msgstr "ネットワーク接続をグラフ表示（稼働中 / 待機 / 合計）\n"

#: src/options.cpp:50
msgid "sample interval (default: 2s)\n"
msgstr "サンプリング間隔（既定値: 2s）\n"

#: src/options.cpp:52
msgid "default visible window; session history stays in memory (default: 3min)\n"
msgstr "既定の表示時間範囲。セッション履歴はメモリに保持（既定値: 3min）\n"

#: src/options.cpp:54
msgid "directory prefix for interval logs (name.pid.log)\n"
msgstr "間隔ログのディレクトリ接頭辞（name.pid.log）\n"

#: src/options.cpp:56
msgid "repeat for more verbose logging\n"
msgstr "繰り返すとログがさらに詳細になります\n"

#: src/options.cpp:58
msgid "show fewer logging messages\n"
msgstr "ログメッセージを減らします\n"

#: src/options.cpp:60
msgid "display this help and exit\n"
msgstr "このヘルプを表示して終了します\n"

#: src/options.cpp:62
msgid "output version information and exit\n"
msgstr "バージョン情報を表示して終了します\n"

#: src/options.cpp:64
msgid "Duration units: ms, s/sec (default), m/min, h. Examples: .5s, 5min.\n"
msgstr "時間単位: ms、s/sec（既定）、m/min、h。例: .5s、5min。\n"

