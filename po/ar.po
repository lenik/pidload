#: src/options.cpp:23
msgid ""
"Usage: pidload [OPTION]... [NAME]...\n"
"Monitor process load and selected device/network traffic in a wxWidgets window.\n"
msgstr ""
"الاستخدام: pidload [OPTION]... [NAME]...\n"
"راقب حمل العمليات وحركة الجهاز/الشبكة المحددة في نافذة wxWidgets.\n"

#: src/options.cpp:27
msgid ""
"Each NAME matches processes, tried as:\n"
"  pid, executable name, executable path, window title,\n"
"  executable glob name, executable glob path, window glob title.\n"
"Glob characters: * ?   Example: pidload editor   pidload '*term*'\n"
msgstr ""
"تتم مطابقة كل NAME مع العمليات بالترتيب الآتي:\n"
"  معرّف العملية، اسم الملف التنفيذي، مساره، عنوان النافذة،\n"
"  نمط اسم الملف التنفيذي، نمط مساره، نمط عنوان النافذة.\n"
"محارف الأنماط: * ?   مثال: pidload editor   pidload '*term*'\n"

#: src/options.cpp:34
msgid "block device I/O to monitor (repeatable)\n"
msgstr "إدخال/إخراج جهاز الكتل المراد مراقبته (قابل للتكرار)\n"

#: src/options.cpp:36
msgid "netdev to monitor, or \"all\" (repeatable)\n"
msgstr "جهاز الشبكة المراد مراقبته، أو \"all\" (قابل للتكرار)\n"

#: src/options.cpp:38
msgid "IPv4/IPv6 address traffic to monitor (repeatable)\n"
msgstr "حركة عنوان IPv4/IPv6 المراد مراقبتها (قابل للتكرار)\n"

#: src/options.cpp:40
msgid "chart system CPU (overall and each core)\n"
msgstr "رسم معالج النظام (الإجمالي وكل نواة)\n"

#: src/options.cpp:42
msgid "chart system memory and swap\n"
msgstr "رسم ذاكرة النظام ومساحة التبديل\n"

#: src/options.cpp:44
msgid "chart thread counts (alive / wait / total opened)\n"
msgstr "رسم أعداد الخيوط (نشطة / منتظرة / إجمالي المفتوحة)\n"

#: src/options.cpp:46
msgid "chart open file-descriptor counts\n"
msgstr "رسم أعداد واصفات الملفات المفتوحة\n"

#: src/options.cpp:48
msgid "chart net connections (alive / wait / total)\n"
msgstr "رسم اتصالات الشبكة (نشطة / منتظرة / الإجمالي)\n"

#: src/options.cpp:50
msgid "sample interval (default: 2s)\n"
msgstr "فاصل أخذ العينات (الافتراضي: 2s)\n"

#: src/options.cpp:52
msgid "default visible window; session history stays in memory (default: 3min)\n"
msgstr "نافذة العرض الافتراضية؛ يبقى سجل الجلسة في الذاكرة (الافتراضي: 3min)\n"

#: src/options.cpp:54
msgid "directory prefix for interval logs (name.pid.log)\n"
msgstr "بادئة دليل سجلات الفواصل (name.pid.log)\n"

#: src/options.cpp:56
msgid "repeat for more verbose logging\n"
msgstr "كرّر لزيادة تفصيل السجل\n"

#: src/options.cpp:58
msgid "show fewer logging messages\n"
msgstr "عرض رسائل سجل أقل\n"

#: src/options.cpp:60
msgid "display this help and exit\n"
msgstr "عرض هذه المساعدة ثم الخروج\n"

#: src/options.cpp:62
msgid "output version information and exit\n"
msgstr "عرض معلومات الإصدار ثم الخروج\n"

#: src/options.cpp:64
msgid "Duration units: ms, s/sec (default), m/min, h. Examples: .5s, 5min.\n"
msgstr "وحدات المدة: ms، وs/sec (الافتراضي)، وm/min، وh. أمثلة: .5s، 5min.\n"

#: src/options.cpp:66
#, c-format
msgid "Report bugs to: <%s>\n"
msgstr "أبلغ عن الأخطاء إلى: <%s>\n"

