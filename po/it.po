#: src/options.cpp:23
msgid ""
"Usage: pidload [OPTION]... [NAME]...\n"
"Monitor process load and selected device/network traffic in a wxWidgets window.\n"
msgstr ""
"Uso: pidload [OPZIONE]... [NOME]...\n"
"Monitora il carico dei processi e il traffico selezionato di dispositivi/rete in una finestra wxWidgets.\n"

#: src/options.cpp:27
msgid ""
"Each NAME matches processes, tried as:\n"
"  pid, executable name, executable path, window title,\n"
"  executable glob name, executable glob path, window glob title.\n"
"Glob characters: * ?   Example: pidload editor   pidload '*term*'\n"
msgstr ""
"Ogni NOME viene confrontato con i processi come:\n"
"  PID, nome o percorso dell’eseguibile, titolo della finestra,\n"
"  glob del nome o percorso dell’eseguibile, o del titolo della finestra.\n"
"Caratteri glob: * ?   Esempio: pidload editor   pidload '*term*'\n"

#: src/options.cpp:34
msgid "block device I/O to monitor (repeatable)\n"
msgstr "I/O del dispositivo a blocchi da monitorare (ripetibile)\n"

#: src/options.cpp:36
msgid "netdev to monitor, or \"all\" (repeatable)\n"
msgstr "Dispositivo di rete da monitorare o \"all\" (ripetibile)\n"

#: src/options.cpp:38
msgid "IPv4/IPv6 address traffic to monitor (repeatable)\n"
msgstr "Traffico dell’indirizzo IPv4/IPv6 da monitorare (ripetibile)\n"

#: src/options.cpp:40
msgid "chart system CPU (overall and each core)\n"
msgstr "Grafico della CPU di sistema (totale e per core)\n"

#: src/options.cpp:42
msgid "chart system memory and swap\n"
msgstr "Grafico della memoria di sistema e dello swap\n"

#: src/options.cpp:44
msgid "chart thread counts (alive / wait / total opened)\n"
msgstr "Grafico del numero di thread (attivi / in attesa / totale aperti)\n"

#: src/options.cpp:46
msgid "chart open file-descriptor counts\n"
msgstr "Grafico del numero di descrittori di file aperti\n"

#: src/options.cpp:48
msgid "chart net connections (alive / wait / total)\n"
msgstr "Grafico delle connessioni di rete (attive / in attesa / totale)\n"

#: src/options.cpp:50
msgid "sample interval (default: 2s)\n"
msgstr "Intervallo di campionamento (predefinito: 2s)\n"

#: src/options.cpp:52
msgid "default visible window; session history stays in memory (default: 3min)\n"
msgstr "Finestra temporale visibile predefinita; la cronologia della sessione resta in memoria (predefinita: 3min)\n"

#: src/options.cpp:54
msgid "directory prefix for interval logs (name.pid.log)\n"
msgstr "Prefisso della directory per i log degli intervalli (name.pid.log)\n"

#: src/options.cpp:56
msgid "repeat for more verbose logging\n"
msgstr "Ripetere per una registrazione più dettagliata\n"

#: src/options.cpp:58
msgid "show fewer logging messages\n"
msgstr "Mostra meno messaggi di log\n"

#: src/options.cpp:60
msgid "display this help and exit\n"
msgstr "Mostra questo aiuto ed esce\n"

#: src/options.cpp:62
msgid "output version information and exit\n"
msgstr "Mostra le informazioni sulla versione ed esce\n"

#: src/options.cpp:64
msgid "Duration units: ms, s/sec (default), m/min, h. Examples: .5s, 5min.\n"
msgstr "Unità di durata: ms, s/sec (predefinita), m/min, h. Esempi: .5s, 5min.\n"

