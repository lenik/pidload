#: src/options.cpp:23
msgid ""
"Usage: pidload [OPTION]... [NAME]...\n"
"Monitor process load and selected device/network traffic in a wxWidgets window.\n"
msgstr ""
"Aufruf: pidload [OPTION]... [NAME]...\n"
"Überwacht Prozesslast und ausgewählten Geräte-/Netzwerkverkehr in einem wxWidgets-Fenster.\n"

#: src/options.cpp:27
msgid ""
"Each NAME matches processes, tried as:\n"
"  pid, executable name, executable path, window title,\n"
"  executable glob name, executable glob path, window glob title.\n"
"Glob characters: * ?   Example: pidload editor   pidload '*term*'\n"
msgstr ""
"Jeder NAME wird wie folgt mit Prozessen abgeglichen:\n"
"  PID, Programmname, Programmpfad, Fenstertitel,\n"
"  Glob-Muster für Programmname, Programmpfad oder Fenstertitel.\n"
"Glob-Zeichen: * ?   Beispiel: pidload editor   pidload '*term*'\n"

#: src/options.cpp:34
msgid "block device I/O to monitor (repeatable)\n"
msgstr "Zu überwachende Blockgeräte-E/A (wiederholbar)\n"

#: src/options.cpp:36
msgid "netdev to monitor, or \"all\" (repeatable)\n"
msgstr "Zu überwachendes Netzwerkgerät oder „all“ (wiederholbar)\n"

#: src/options.cpp:38
msgid "IPv4/IPv6 address traffic to monitor (repeatable)\n"
msgstr "Zu überwachender IPv4-/IPv6-Adressverkehr (wiederholbar)\n"

#: src/options.cpp:40
msgid "chart system CPU (overall and each core)\n"
msgstr "System-CPU darstellen (gesamt und je Kern)\n"

#: src/options.cpp:42
msgid "chart system memory and swap\n"
msgstr "Systemspeicher und Auslagerung darstellen\n"

#: src/options.cpp:44
msgid "chart thread counts (alive / wait / total opened)\n"
msgstr "Thread-Anzahlen darstellen (aktiv / wartend / insgesamt geöffnet)\n"

#: src/options.cpp:46
msgid "chart open file-descriptor counts\n"
msgstr "Anzahl offener Dateideskriptoren darstellen\n"

#: src/options.cpp:48
msgid "chart net connections (alive / wait / total)\n"
msgstr "Netzwerkverbindungen darstellen (aktiv / wartend / gesamt)\n"

#: src/options.cpp:50
msgid "sample interval (default: 2s)\n"
msgstr "Abtastintervall (Standard: 2s)\n"

#: src/options.cpp:52
msgid "default visible window; session history stays in memory (default: 3min)\n"
msgstr "Standardmäßig sichtbarer Zeitraum; Sitzungsverlauf bleibt im Speicher (Standard: 3min)\n"

#: src/options.cpp:54
msgid "directory prefix for interval logs (name.pid.log)\n"
msgstr "Verzeichnispräfix für Intervallprotokolle (name.pid.log)\n"

#: src/options.cpp:56
msgid "repeat for more verbose logging\n"
msgstr "Für ausführlichere Protokollierung wiederholen\n"

#: src/options.cpp:58
msgid "show fewer logging messages\n"
msgstr "Weniger Protokollmeldungen anzeigen\n"

#: src/options.cpp:60
msgid "display this help and exit\n"
msgstr "Diese Hilfe anzeigen und beenden\n"

#: src/options.cpp:62
msgid "output version information and exit\n"
msgstr "Versionsinformationen ausgeben und beenden\n"

#: src/options.cpp:64
msgid "Duration units: ms, s/sec (default), m/min, h. Examples: .5s, 5min.\n"
msgstr "Zeiteinheiten: ms, s/sec (Standard), m/min, h. Beispiele: .5s, 5min.\n"

