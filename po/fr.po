#: src/options.cpp:23
msgid ""
"Usage: pidload [OPTION]... [NAME]...\n"
"Monitor process load and selected device/network traffic in a wxWidgets window.\n"
msgstr ""
"Utilisation : pidload [OPTION]... [NOM]...\n"
"Surveille la charge des processus et le trafic des périphériques/réseaux sélectionnés dans une fenêtre wxWidgets.\n"

#: src/options.cpp:27
msgid ""
"Each NAME matches processes, tried as:\n"
"  pid, executable name, executable path, window title,\n"
"  executable glob name, executable glob path, window glob title.\n"
"Glob characters: * ?   Example: pidload editor   pidload '*term*'\n"
msgstr ""
"Chaque NOM est comparé aux processus comme suit :\n"
"  PID, nom ou chemin de l’exécutable, titre de fenêtre,\n"
"  motif glob du nom ou chemin de l’exécutable, ou du titre de fenêtre.\n"
"Caractères glob : * ?   Exemple : pidload editor   pidload '*term*'\n"

#: src/options.cpp:34
msgid "block device I/O to monitor (repeatable)\n"
msgstr "E/S du périphérique bloc à surveiller (répétable)\n"

#: src/options.cpp:36
msgid "netdev to monitor, or \"all\" (repeatable)\n"
msgstr "Périphérique réseau à surveiller ou « all » (répétable)\n"

#: src/options.cpp:38
msgid "IPv4/IPv6 address traffic to monitor (repeatable)\n"
msgstr "Trafic d’une adresse IPv4/IPv6 à surveiller (répétable)\n"

#: src/options.cpp:40
msgid "chart system CPU (overall and each core)\n"
msgstr "Tracer le processeur système (global et par cœur)\n"

#: src/options.cpp:42
msgid "chart system memory and swap\n"
msgstr "Tracer la mémoire système et l’espace d’échange\n"

#: src/options.cpp:44
msgid "chart thread counts (alive / wait / total opened)\n"
msgstr "Tracer le nombre de threads (actifs / en attente / total ouverts)\n"

#: src/options.cpp:46
msgid "chart open file-descriptor counts\n"
msgstr "Tracer le nombre de descripteurs de fichiers ouverts\n"

#: src/options.cpp:48
msgid "chart net connections (alive / wait / total)\n"
msgstr "Tracer les connexions réseau (actives / en attente / total)\n"

#: src/options.cpp:50
msgid "sample interval (default: 2s)\n"
msgstr "Intervalle d’échantillonnage (par défaut : 2s)\n"

#: src/options.cpp:52
msgid "default visible window; session history stays in memory (default: 3min)\n"
msgstr "Fenêtre temporelle visible par défaut ; l’historique de session reste en mémoire (par défaut : 3min)\n"

#: src/options.cpp:54
msgid "directory prefix for interval logs (name.pid.log)\n"
msgstr "Préfixe de répertoire des journaux d’intervalle (name.pid.log)\n"

#: src/options.cpp:56
msgid "repeat for more verbose logging\n"
msgstr "Répéter pour une journalisation plus détaillée\n"

#: src/options.cpp:58
msgid "show fewer logging messages\n"
msgstr "Afficher moins de messages de journal\n"

#: src/options.cpp:60
msgid "display this help and exit\n"
msgstr "Afficher cette aide et quitter\n"

#: src/options.cpp:62
msgid "output version information and exit\n"
msgstr "Afficher les informations de version et quitter\n"

#: src/options.cpp:64
msgid "Duration units: ms, s/sec (default), m/min, h. Examples: .5s, 5min.\n"
msgstr "Unités de durée : ms, s/sec (par défaut), m/min, h. Exemples : .5s, 5min.\n"

