#: src/options.cpp:23
msgid ""
"Usage: pidload [OPTION]... [NAME]...\n"
"Monitor process load and selected device/network traffic in a wxWidgets window.\n"
msgstr ""
"Uso: pidload [OPCIÓN]... [NOMBRE]...\n"
"Monitorea la carga de procesos y el tráfico seleccionado de dispositivos/red en una ventana de wxWidgets.\n"

#: src/options.cpp:27
msgid ""
"Each NAME matches processes, tried as:\n"
"  pid, executable name, executable path, window title,\n"
"  executable glob name, executable glob path, window glob title.\n"
"Glob characters: * ?   Example: pidload editor   pidload '*term*'\n"
msgstr ""
"Cada NOMBRE se compara con procesos, probando como:\n"
"  PID, nombre o ruta del ejecutable, título de ventana,\n"
"  patrón glob del nombre o ruta del ejecutable, o del título de ventana.\n"
"Caracteres glob: * ?   Ejemplo: pidload editor   pidload '*term*'\n"

#: src/options.cpp:34
msgid "block device I/O to monitor (repeatable)\n"
msgstr "E/S de dispositivo de bloques por monitorear (repetible)\n"

#: src/options.cpp:36
msgid "netdev to monitor, or \"all\" (repeatable)\n"
msgstr "Dispositivo de red por monitorear o \"all\" (repetible)\n"

#: src/options.cpp:38
msgid "IPv4/IPv6 address traffic to monitor (repeatable)\n"
msgstr "Tráfico de dirección IPv4/IPv6 por monitorear (repetible)\n"

#: src/options.cpp:40
msgid "chart system CPU (overall and each core)\n"
msgstr "Graficar CPU del sistema (total y cada núcleo)\n"

#: src/options.cpp:42
msgid "chart system memory and swap\n"
msgstr "Graficar memoria y espacio de intercambio del sistema\n"

#: src/options.cpp:44
msgid "chart thread counts (alive / wait / total opened)\n"
msgstr "Graficar conteos de hilos (activos / en espera / total abiertos)\n"

#: src/options.cpp:46
msgid "chart open file-descriptor counts\n"
msgstr "Graficar conteos de descriptores de archivo abiertos\n"

#: src/options.cpp:48
msgid "chart net connections (alive / wait / total)\n"
msgstr "Graficar conexiones de red (activas / en espera / total)\n"

#: src/options.cpp:50
msgid "sample interval (default: 2s)\n"
msgstr "Intervalo de muestreo (predeterminado: 2s)\n"

#: src/options.cpp:52
msgid "default visible window; session history stays in memory (default: 3min)\n"
msgstr "Ventana visible predeterminada; el historial de la sesión permanece en memoria (predeterminado: 3min)\n"

#: src/options.cpp:54
msgid "directory prefix for interval logs (name.pid.log)\n"
msgstr "Prefijo de directorio para registros por intervalo (name.pid.log)\n"

#: src/options.cpp:56
msgid "repeat for more verbose logging\n"
msgstr "Repetir para un registro más detallado\n"

#: src/options.cpp:58
msgid "show fewer logging messages\n"
msgstr "Mostrar menos mensajes de registro\n"

#: src/options.cpp:60
msgid "display this help and exit\n"
msgstr "Mostrar esta ayuda y salir\n"

#: src/options.cpp:62
msgid "output version information and exit\n"
msgstr "Mostrar información de versión y salir\n"

#: src/options.cpp:64
msgid "Duration units: ms, s/sec (default), m/min, h. Examples: .5s, 5min.\n"
msgstr "Unidades de duración: ms, s/sec (predeterminada), m/min, h. Ejemplos: .5s, 5min.\n"

