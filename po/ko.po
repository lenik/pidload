#: src/options.cpp:23
msgid ""
"Usage: pidload [OPTION]... [NAME]...\n"
"Monitor process load and selected device/network traffic in a wxWidgets window.\n"
msgstr ""
"사용법: pidload [옵션]... [이름]...\n"
"wxWidgets 창에서 프로세스 부하와 선택한 장치/네트워크 트래픽을 모니터링합니다.\n"

#: src/options.cpp:27
msgid ""
"Each NAME matches processes, tried as:\n"
"  pid, executable name, executable path, window title,\n"
"  executable glob name, executable glob path, window glob title.\n"
"Glob characters: * ?   Example: pidload editor   pidload '*term*'\n"
msgstr ""
"각 이름은 다음 순서로 프로세스와 대조됩니다:\n"
"  PID, 실행 파일 이름, 실행 파일 경로, 창 제목,\n"
"  실행 파일 이름/경로/창 제목의 glob 패턴.\n"
"glob 문자: * ?   예: pidload editor   pidload '*term*'\n"

#: src/options.cpp:34
msgid "block device I/O to monitor (repeatable)\n"
msgstr "모니터링할 블록 장치 I/O(반복 가능)\n"

#: src/options.cpp:36
msgid "netdev to monitor, or \"all\" (repeatable)\n"
msgstr "모니터링할 네트워크 장치 또는 \"all\"(반복 가능)\n"

#: src/options.cpp:38
msgid "IPv4/IPv6 address traffic to monitor (repeatable)\n"
msgstr "모니터링할 IPv4/IPv6 주소 트래픽(반복 가능)\n"

#: src/options.cpp:40
msgid "chart system CPU (overall and each core)\n"
msgstr "시스템 CPU 차트 표시(전체 및 코어별)\n"

#: src/options.cpp:42
msgid "chart system memory and swap\n"
msgstr "시스템 메모리 및 스왑 차트 표시\n"

#: src/options.cpp:44
msgid "chart thread counts (alive / wait / total opened)\n"
msgstr "스레드 수 차트 표시(활성 / 대기 / 열린 총계)\n"

#: src/options.cpp:46
msgid "chart open file-descriptor counts\n"
msgstr "열린 파일 디스크립터 수 차트 표시\n"

#: src/options.cpp:48
msgid "chart net connections (alive / wait / total)\n"
msgstr "네트워크 연결 차트 표시(활성 / 대기 / 합계)\n"

#: src/options.cpp:50
msgid "sample interval (default: 2s)\n"
msgstr "샘플링 간격(기본값: 2s)\n"

#: src/options.cpp:52
msgid "default visible window; session history stays in memory (default: 3min)\n"
msgstr "기본 표시 시간 범위. 세션 기록은 메모리에 유지됨(기본값: 3min)\n"

#: src/options.cpp:54
msgid "directory prefix for interval logs (name.pid.log)\n"
msgstr "간격 로그의 디렉터리 접두사(name.pid.log)\n"

#: src/options.cpp:56
msgid "repeat for more verbose logging\n"
msgstr "더 자세한 로깅을 위해 반복 지정\n"

#: src/options.cpp:58
msgid "show fewer logging messages\n"
msgstr "로그 메시지를 줄여 표시\n"

#: src/options.cpp:60
msgid "display this help and exit\n"
msgstr "이 도움말을 표시하고 종료\n"

#: src/options.cpp:62
msgid "output version information and exit\n"
msgstr "버전 정보를 출력하고 종료\n"

#: src/options.cpp:64
msgid "Duration units: ms, s/sec (default), m/min, h. Examples: .5s, 5min.\n"
msgstr "기간 단위: ms, s/sec(기본값), m/min, h. 예: .5s, 5min.\n"

#: src/options.cpp:66
#, c-format
msgid "Report bugs to: <%s>\n"
msgstr "버그 보고: <%s>\n"

